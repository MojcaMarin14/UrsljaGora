# Example only. Generate new secrets with scripts/init-env.py --backend.
COMPOSE_PROJECT_NAME=urslja-gora-backend
RELEASE_TAG=first
CMS_DOMAIN=cms.YOUR-DOMAIN.si
NEXT_PUBLIC_STRAPI_URL=https://cms.YOUR-DOMAIN.si
NEXT_PUBLIC_SITE_URL=https://urslja-gora.vercel.app
CORS_ORIGINS=https://urslja-gora.vercel.app
ACME_EMAIL=YOUR-EMAIL
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
RESTIC_REPOSITORY=s3:https://YOUR-OFF-SERVER-STORAGE/urslja-gora-backups
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bootstrap/recovery role; never passed into the Strapi container. New volumes only.
DATABASE_ADMIN_USERNAME=urslja_admin
DATABASE_ADMIN_PASSWORD=
AWS_DEFAULT_REGION=fsn1
