FROM restic/restic:0.18.1 AS restic
FROM postgres:16-bookworm
COPY --from=restic /usr/bin/restic /usr/local/bin/restic
COPY scripts/backup-job.sh scripts/restore-job.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/backup-job.sh /usr/local/bin/restore-job.sh
ENTRYPOINT ["/usr/local/bin/backup-job.sh"]
