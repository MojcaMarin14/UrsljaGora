{
    email {$ACME_EMAIL}
    admin off
}

{$SITE_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    reverse_proxy frontend:3000
}

www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$CMS_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 64MB
    }
    reverse_proxy strapi:1337
}
