# Copy privately to .env.local; never commit real credentials.
# Local development only. Vercel Preview requires a PUBLIC HTTPS CMS origin.
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Leave unset on Vercel; optional Docker-only server override:
# STRAPI_INTERNAL_URL=http://strapi:1337
ALLOW_PRIVATE_CMS_IMAGES=false
CONTACT_LOCAL_TEST=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=
# Optional licensed server-side weather provider key; never NEXT_PUBLIC_.
WEATHER_API_KEY=
