# Safe template only. Set values privately in the new Strapi Cloud project.
# Cloud provides NODE_ENV=production, PORT, database connection and app secrets.
# Do not copy local database credentials, URLs, SMTP or keys into Cloud.
CORS_ORIGINS=https://urslja-gora.vercel.app
# Keep empty until the actual new Cloud URL is known, or omit the variable.
PUBLIC_URL=
TRUST_PROXY=true
# Required only for the first start of a new empty project. Password: 20-128 chars.
# Set these before the first deployment. Existing administrators are never reset.
CLOUD_BOOTSTRAP_ADMIN_EMAIL=
CLOUD_BOOTSTRAP_ADMIN_PASSWORD=
CLOUD_BOOTSTRAP_ADMIN_FIRSTNAME=
CLOUD_BOOTSTRAP_ADMIN_LASTNAME=
# Default off. Enable only for an approved transfer into a backed-up empty target.
CLOUD_TRANSFER_ENABLED=false
# Default off. Verify originals, variants, revocation and CDN cache privacy first.
CLOUD_COMMUNITY_MEDIA_VERIFIED=false
